+# In standalone builds xpti is installed as an external CMake package exporting
+# the `xpti::xpti` target. add_dependencies/target_link_libraries below
+# reference the bare `xpti` name, so alias it.
+if (NOT TARGET xpti)
+  find_package(xpti REQUIRED)
+  add_library(xpti ALIAS xpti::xpti)
+endif()
+
 option(XPTI_ENABLE_WERROR OFF)
 option(XPTI_BUILD_SAMPLES OFF)
 option(XPTI_BUILD_BENCHMARK OFF)
