--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,21 @@
 cmake_minimum_required(VERSION 3.20.0 FATAL_ERROR)
 
+# Standalone build support
+if(NOT LLVM_MAIN_SRC_DIR)
+  project(sycl-jit C CXX)
+  option(SYCL_JIT_INCLUDE_TESTS
+    "Generate build targets for the sycl-jit lit tests." OFF)
+  find_package(LLVM REQUIRED CONFIG)
+  list(APPEND CMAKE_MODULE_PATH "${LLVM_CMAKE_DIR}")
+  include(AddLLVM)
+  include(HandleLLVMOptions)
+  find_package(Clang REQUIRED CONFIG)
+  find_package(Python3 REQUIRED)
+  # Standard in LLVM-family standalone builds (clang/lld/mlir/flang/lldb all
+  # set this); makes generated headers under the binary tree visible.
+  set(CMAKE_INCLUDE_CURRENT_DIR ON)
+endif()
+
 # Define a variable holding the root directory of the JIT compiler project
 # for use in includes etc.
 set(SYCL_JIT_BASE_DIR ${CMAKE_CURRENT_SOURCE_DIR})
@@ -7,7 +23,18 @@ set(SYCL_JIT_BASE_DIR ${CMAKE_CURRENT_SOURCE_DIR})
 # For some reason, the LLVMSPIRVLib does not define any public includes.
 # To link against the library, define the following link to its include
 # directories, similar to how clang/CMakeLists.txt does it.
-set(LLVM_SPIRV_INCLUDE_DIRS "${LLVM_MAIN_SRC_DIR}/../llvm-spirv/include")
+if(NOT LLVM_SPIRV_INCLUDE_DIRS)
+  if(NOT LLVM_MAIN_SRC_DIR)
+    message(FATAL_ERROR
+      "LLVM_SPIRV_INCLUDE_DIRS must be set for standalone sycl-jit builds.\n"
+      "Pass -DLLVM_SPIRV_INCLUDE_DIRS=<path-to-llvm-spirv/include>.")
+  endif()
+  set(LLVM_SPIRV_INCLUDE_DIRS "${LLVM_MAIN_SRC_DIR}/../llvm-spirv/include")
+endif()
+
+if(NOT LLVM_MAIN_SRC_DIR AND NOT TARGET sycl-headers)
+  add_custom_target(sycl-headers)
+endif()
 
 if (NOT WIN32 AND NOT CYGWIN)
   # Set library-wide warning options.
@@ -26,5 +53,9 @@ add_subdirectory(passes)
 # Loadable plugins for opt aren't supported on Windows,
 # so we can't execute the tests.
 if (NOT WIN32 AND NOT CYGWIN)
-  add_subdirectory(test)
+  # The lit suite requires in-tree build targets (opt, FileCheck); in
+  # standalone builds it is opt-in via SYCL_JIT_INCLUDE_TESTS.
+  if(LLVM_MAIN_SRC_DIR OR SYCL_JIT_INCLUDE_TESTS)
+    add_subdirectory(test)
+  endif()
 endif()
